# ==============================================================================
# ECHO AI TUTOR - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Replace the placeholder values with your real Twilio & ElevenLabs API keys.
# 3. In Flutter, pass these variables during run/build using:
#      flutter run --dart-define-from-file=.env
#    OR enter them directly in the in-app Voice Call Settings dialog.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TWILIO OUTBOUND VOICE CALL CONFIGURATION
# ------------------------------------------------------------------------------
# Retrieve from: https://console.twilio.com/
# - TWILIO_ACCOUNT_SID: Found on the main Twilio Console dashboard (starts with AC...)
# - TWILIO_AUTH_TOKEN: Found on the main Twilio Console dashboard
# - TWILIO_FROM_NUMBER: Your purchased Twilio phone number in E.164 format (e.g. +14155552671)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+14155552671

# ------------------------------------------------------------------------------
# 2. ELEVENLABS CONVERSATIONAL AI & TTS CONFIGURATION
# ------------------------------------------------------------------------------
# Retrieve from: https://elevenlabs.io/app/settings/api-keys
# - ELEVENLABS_API_KEY: Your ElevenLabs API key (starts with sk_... or xi_...)
# - ELEVENLABS_AGENT_ID: (Optional) If using ElevenLabs Conversational AI Agent
# - ELEVENLABS_VOICE_ID: Voice used for speech synthesis (Default: Rachel)
#     Rachel (Calm & Clear): 21m00Tcm4TlvDq8ikWAM
#     Adam (Dynamic):        pNInz6obpgDQGcFmaJgB
#     Josh (Energetic):      TxGEqnHWrfWFTfGW9XjX
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 3. STUDENT DEFAULT PHONE NUMBER
# ------------------------------------------------------------------------------
# Recipient phone number for outbound doubt-solving calls (must include country code)
# Example India: +919876543210 | Example US: +14155550199
STUDENT_PHONE_NUMBER=+919876543210
